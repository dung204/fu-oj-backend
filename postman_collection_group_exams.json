{
  "info": {
    "name": "FU OJ - Group Exams API",
    "description": "Collection for Group Exam APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Group Exams",
      "item": [
        {
          "name": "Get Group Exams",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/group-exams",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "group-exams"],
              "query": [
                {
                  "key": "groupId",
                  "value": "",
                  "disabled": true,
                  "description": "Filter by group ID"
                },
                {
                  "key": "examId",
                  "value": "",
                  "disabled": true,
                  "description": "Filter by exam ID"
                },
                {
                  "key": "ownerId",
                  "value": "",
                  "disabled": true,
                  "description": "Filter by instructor owner ID"
                },
                {
                  "key": "status",
                  "value": "",
                  "disabled": true,
                  "description": "Filter by status (DRAFT, UPCOMING, ONGOING, COMPLETED, CANCELLED, OUTDATED)"
                }
              ]
            },
            "description": "Get all group exams with optional filters"
          },
          "response": []
        },
        {
          "name": "Get Group Exams by Group",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/group-exams?groupId=group-id-here",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "group-exams"],
              "query": [
                {
                  "key": "groupId",
                  "value": "group-id-here",
                  "description": "Filter by specific group ID"
                }
              ]
            },
            "description": "Get all exams for a specific group"
          },
          "response": []
        },
        {
          "name": "Get Group Exams by Exam",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/group-exams?examId=exam-id-here",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "group-exams"],
              "query": [
                {
                  "key": "examId",
                  "value": "exam-id-here",
                  "description": "Filter by specific exam ID (all groups for this exam)"
                }
              ]
            },
            "description": "Get all groups that have a specific exam"
          },
          "response": []
        },
        {
          "name": "Get Group Exams by Owner",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/group-exams?ownerId=instructor-id-here",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "group-exams"],
              "query": [
                {
                  "key": "ownerId",
                  "value": "instructor-id-here",
                  "description": "Filter by instructor owner ID"
                }
              ]
            },
            "description": "Get all group exams where the instructor is the owner"
          },
          "response": []
        },
        {
          "name": "Get Group Exams by Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/group-exams?status=ONGOING",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "group-exams"],
              "query": [
                {
                  "key": "status",
                  "value": "ONGOING",
                  "description": "Filter by status (DRAFT, UPCOMING, ONGOING, COMPLETED, CANCELLED, OUTDATED)"
                }
              ]
            },
            "description": "Get all group exams with specific status"
          },
          "response": []
        },
        {
          "name": "Get Group Exams - Combined Filters",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/group-exams?groupId=group-id-here&examId=exam-id-here&ownerId=instructor-id-here&status=ONGOING",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "group-exams"],
              "query": [
                {
                  "key": "groupId",
                  "value": "group-id-here",
                  "description": "Filter by group ID"
                },
                {
                  "key": "examId",
                  "value": "exam-id-here",
                  "description": "Filter by exam ID"
                },
                {
                  "key": "ownerId",
                  "value": "instructor-id-here",
                  "description": "Filter by instructor owner ID"
                },
                {
                  "key": "status",
                  "value": "ONGOING",
                  "description": "Filter by status"
                }
              ]
            },
            "description": "Get group exams with multiple filters combined"
          },
          "response": []
        }
      ],
      "description": "APIs for managing group exams - mapping between groups and exams"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  }
}

